let currentBranch = null;

function tagClass(doc) {
  const d = doc.toLowerCase();
  if (/invoice at|sale.s invoice|purchase invoice/.test(d)) return ['t-invoice', '&#128196;'];
  if (/proof of payment|bank card|open balance|proforma|proof end finance|end lease|loan.s open|cvc|diff\./.test(d)) return ['t-payment', '&#128184;'];
  if (/registration cert|deregistration/.test(d)) return ['t-reg', '&#128221;'];
  if (/identity card|power of attorney|death cert|inheritance|succession|confirmation from accountant|debt free|document national bank|dnb|bank.s cert/.test(d)) return ['t-id', '&#128100;'];
  if (/loan|finance|leasing|spare key|copy of loan/.test(d)) return ['t-finance', '&#128176;'];
  if (/wrong|cdu|car data update|ccv|name change|not right|file wrong/.test(d)) return ['t-wrong', '&#9888;'];
  return ['t-other', '&#183;'];
}

function buildTags(lead) {
  let html = '';
  if (lead.factuur === 'Wrong invoice')
    html += '<span class="tag t-wrong"><span class="tag-icon">&#9888;</span>Wrong invoice</span>';

  lead.docs.forEach(d => {
    const [cls, icon] = tagClass(d);
    html += '<span class="tag ' + cls + '"><span class="tag-icon">' + icon + '</span>' + d + '</span>';
  });
  lead.flags.forEach(f => {
    html += '<span class="tag t-approval"><span class="tag-icon">&#128338;</span>' + f + '</span>';
  });
  if (!html) html = '<span class="tag t-other">No details</span>';
  return html;
}

/* ── Page navigation ── */
function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function goBack() {
  currentBranch = null;
  document.getElementById('leadSearch').value = '';
  showPage('page-branches');
}

function openBranch(branchName) {
  currentBranch = DATA.find(b => b.branch === branchName);
  document.getElementById('leadSearch').value = '';
  document.getElementById('detailTitle').textContent = branchName;
  renderDetail();
  showPage('page-detail');
}

/* ── Render branches ── */
function renderBranches() {
  const q = document.getElementById('branchSearch').value.trim().toLowerCase();
  const grid = document.getElementById('branchGrid');
  let html = '';
  let totalLeads = 0;

  DATA.forEach(b => {
    if (q && !b.branch.toLowerCase().includes(q)) return;
    if (!b.leads.length) return;

    totalLeads += b.leads.length;
    html += '<div class="branch-card" data-branch="' + b.branch.replace(/"/g, '&quot;') + '" onclick="openBranch(this.dataset.branch)">'
      + '<div class="bname">' + b.branch + '</div>'
      + '<div class="bcount">' + b.leads.length + ' open</div>'
      + '</div>';
  });

  grid.innerHTML = html;
  document.getElementById('branchNoResults').style.display = html ? 'none' : '';
  document.getElementById('branchStatLine').textContent =
    totalLeads + ' open leads across ' + document.querySelectorAll('.branch-card').length + ' branches';
}

/* ── Render detail ── */
function renderDetail() {
  if (!currentBranch) return;
  const q = document.getElementById('leadSearch').value.trim().toLowerCase();

  const leads = currentBranch.leads.filter(l => {
    if (!q) return true;
    return l.leadId.toLowerCase().includes(q)
        || l.docs.some(d => d.toLowerCase().includes(q))
        || l.flags.some(f => f.toLowerCase().includes(q))
        || l.note.toLowerCase().includes(q);
  });

  document.getElementById('detailSub').textContent =
    currentBranch.leads.length + ' open lead' + (currentBranch.leads.length !== 1 ? 's' : '');

  let html = '';
  leads.forEach(l => {
    html += '<div class="lead-card">'
      + '<div class="lead-header">'
      +   '<span class="lead-id">' + l.leadId + '</span>'
      + '</div>'
      + '<div class="items-label">Missing / Blocking</div>'
      + '<div class="tags-wrap">' + buildTags(l) + '</div>'
      + (l.note ? '<div class="note-text">' + l.note + '</div>' : '')
      + '</div>';
  });

  document.getElementById('leadList').innerHTML = html;
  document.getElementById('leadNoResults').style.display = leads.length ? 'none' : '';
}

window.onload = renderBranches;
</script>
