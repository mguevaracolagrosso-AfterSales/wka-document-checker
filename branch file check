<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  *, *::before, *::after { box-sizing: border-box; }
  body { font-family: system-ui, sans-serif; margin: 0; font-size: 13px; min-height: 100vh; }

  /* ── Layout ── */
  .page { display: none; padding: 20px 24px; max-width: 960px; margin: 0 auto; }
  .page.active { display: block; }

  /* ── Header ── */
  .header { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .header h1 { font-size: 16px; font-weight: 700; margin: 0; flex: 1; }
  .back-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border: 1px solid rgba(128,128,128,0.3);
    border-radius: 6px; background: transparent; font-family: inherit;
    font-size: 13px; cursor: pointer; opacity: 0.7;
  }
  .back-btn:hover { opacity: 1; }

  /* ── Search ── */
  .search-wrap { position: relative; margin-bottom: 18px; }
  .search-wrap input {
    width: 100%; padding: 9px 14px 9px 36px;
    border: 1px solid rgba(128,128,128,0.3); border-radius: 8px;
    background: transparent; font-family: inherit; font-size: 13px;
    outline: none;
  }
  .search-wrap input:focus { border-color: rgba(99,102,241,0.6); }
  .search-icon {
    position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
    opacity: 0.35; font-size: 14px; pointer-events: none;
  }

  .stat-line { font-size: 12px; opacity: 0.5; margin-bottom: 14px; }

  /* ── Branch cards (page 1) ── */
  .branch-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
  .branch-card {
    padding: 14px 16px; border: 1px solid rgba(128,128,128,0.18);
    border-radius: 10px; cursor: pointer; transition: border-color .15s, box-shadow .15s;
    display: flex; align-items: center; justify-content: space-between;
  }
  .branch-card:hover { border-color: rgba(99,102,241,0.45); box-shadow: 0 2px 10px rgba(99,102,241,0.08); }
  .branch-card .bname { font-weight: 700; font-size: 14px; }
  .branch-card .bcount {
    font-size: 12px; font-weight: 700; background: rgba(128,128,128,0.1);
    padding: 2px 9px; border-radius: 20px; white-space: nowrap;
  }

  /* ── Lead rows (page 2) ── */
  .branch-title { font-size: 20px; font-weight: 700; }
  .branch-sub   { font-size: 12px; opacity: 0.5; margin-top: 2px; margin-bottom: 20px; }

  .lead-list { display: flex; flex-direction: column; gap: 10px; }
  .lead-card {
    border: 1px solid rgba(128,128,128,0.18); border-radius: 10px; padding: 14px 16px;
  }
  .lead-header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .lead-id { font-family: monospace; font-weight: 700; font-size: 13px; }

  .items-label { font-size: 10px; font-weight: 700; opacity: 0.4; text-transform: uppercase;
    letter-spacing: .06em; margin-bottom: 6px; }
  .tags-wrap { display: flex; flex-wrap: wrap; gap: 5px; }
  .tag {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 10px; border-radius: 6px; font-size: 12px;
    border: 1px solid transparent;
  }
  .tag-icon { font-size: 11px; }
  .t-invoice  { background:rgba(245,158,11,0.1);  border-color:rgba(245,158,11,0.3); }
  .t-payment  { background:rgba(59,130,246,0.1);  border-color:rgba(59,130,246,0.3); }
  .t-reg      { background:rgba(139,92,246,0.1);  border-color:rgba(139,92,246,0.3); }
  .t-id       { background:rgba(236,72,153,0.1);  border-color:rgba(236,72,153,0.3); }
  .t-finance  { background:rgba(16,185,129,0.1);  border-color:rgba(16,185,129,0.3); }
  .t-approval { background:rgba(99,102,241,0.12); border-color:rgba(99,102,241,0.35); font-weight:600; }
  .t-wrong    { background:rgba(239,68,68,0.1);   border-color:rgba(239,68,68,0.3); }
  .t-other    { background:rgba(128,128,128,0.08);border-color:rgba(128,128,128,0.2); }

  .note-text { font-size: 11px; opacity: 0.5; margin-top: 8px; font-style: italic; }

  .no-results { padding: 40px; text-align: center; opacity: 0.4; }
</style>
</head>
<body>

<!-- PAGE 1: Branch list -->
<div class="page active" id="page-branches">
  <div class="header">
    <h1>Open Leads · May 2026</h1>
  </div>
  <div class="search-wrap">
    <span class="search-icon">&#128269;</span>
    <input type="text" id="branchSearch" placeholder="Search branch…" oninput="renderBranches()">
  </div>
  <div class="stat-line" id="branchStatLine"></div>
  <div class="branch-grid" id="branchGrid"></div>
  <div id="branchNoResults" class="no-results" style="display:none">No branches match.</div>
</div>

<!-- PAGE 2: Branch detail -->
<div class="page" id="page-detail">
  <div class="header">
    <button class="back-btn" onclick="goBack()">&#8592; Branches</button>
  </div>
  <div class="branch-title" id="detailTitle"></div>
  <div class="branch-sub"   id="detailSub"></div>
  <div class="search-wrap">
    <span class="search-icon">&#128269;</span>
    <input type="text" id="leadSearch" placeholder="Search lead ID or document…" oninput="renderDetail()">
  </div>
  <div class="lead-list" id="leadList"></div>
  <div id="leadNoResults" class="no-results" style="display:none">No leads match.</div>
</div>

